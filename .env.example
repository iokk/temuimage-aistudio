# 电商出图工作台示例配置
# 复制为 .env 后按需修改

# 运行模式: desktop / server
APP_RUNTIME=server

# 宿主监听地址与端口。默认只允许本机或本机反向代理访问。
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8501

# 图片生成/编辑请求最长等待时间（秒）。慢速图片模型建议 300 秒。
GEMINI_IMAGE_REQUEST_TIMEOUT_SECONDS=300

# 如果 providers.json 为空，首次启动可用以下任意一个 Key 自动创建默认 Gemini 提供商
# 这些值保留在运行环境/.env 中，不会复制到 providers.json；请将实际 .env 设为 600 且不要提交
GOOGLE_API_KEY=
GEMINI_API_KEY=

# 运行时数据目录
# Linux / Docker 建议保留 /app/data
ECOMMERCE_WORKBENCH_DATA_DIR=/app/data

# 本地面试/演示模式：开放管理员 Demo 面板，并允许一键使用测试密钥；生产建议保持 0
XIAOBAITU_DEMO_MODE=0

# 项目输出目录
# server 版默认写入服务器项目中心
ECOMMERCE_WORKBENCH_PROJECTS_DIR=/app/data/projects

# 文件存储配置
FILE_STORAGE_TYPE=local
FILE_RETENTION_DAYS=7
FILE_STORAGE_PATH=/app/data/files

# S3 / 对象存储，可选
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PREFIX=temu-files/
S3_PRESIGN_EXPIRES=86400

# 说明
# 1. server 版结果会先进入服务器项目中心，用户再通过浏览器下载
# 2. desktop 版允许打开本地文件夹和自定义本地保存目录
# 3. server 版不依赖 macOS Keychain

# 服务器模式必须设置访问口令；留空时 Compose 拒绝启动，应用也会停止访问。
APP_ACCESS_PASSWORD=

# 可选：外部提供的Fernet密钥，避免与数据同盘存储
XIAOBAITU_SECRET_KEY=
